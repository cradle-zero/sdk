{
  "name": "cradlezero",
  "version": "0.2.1",
  "description": "Public constants, Construct ABI headers, manifest validator, and telemetry frame reader for CradleZero.",
  "license": "MIT",
  "author": "CradleZero",
  "homepage": "https://cradlezero.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cradle-zero/sdk.git",
    "directory": "packages/cradlezero"
  },
  "bugs": {
    "url": "https://github.com/cradle-zero/sdk/issues"
  },
  "keywords": [
    "cradlezero",
    "webassembly",
    "abi",
    "construct"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "default": "./dist/telemetry.js"
    },
    "./fixtures/*": "./fixtures/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fixtures",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "24.19.4",
    "typescript": "6.0.3",
    "vitest": "5.1.2"
  }
}
